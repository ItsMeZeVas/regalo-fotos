# Estas variables se configuran en el dashboard de Vercel (Settings > Environment Variables)
# NUNCA las subas a GitHub en un archivo .env real.

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=tu_usuario_github
GITHUB_REPO=insta-regalo-fotos
GITHUB_BRANCH=main

# Clave simple para que solo ustedes dos puedan subir fotos (opcional pero recomendado)
UPLOAD_PASSCODE=escoge-una-clave
